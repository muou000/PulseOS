index 00000000..b2088f93
--- /dev/null
+++ b/modules/fs/src/sst_observe.rs
@@ -0,0 +1,84 @@
+// Diagnostic kernel used by the single-SST, single-reader #284 workload.
+use alloc::{boxed::Box, string::String};
+use core::{fmt::Write, sync::atomic::{AtomicU64, Ordering::Relaxed}};
+use kspin::SpinNoPreempt;
+
+macro_rules! counters {
+    ($($ident:ident => $name:literal),+ $(,)?) => {
+        $(pub(crate) static $ident: AtomicU64 = AtomicU64::new(0);)+
+        pub(crate) fn append(out: &mut String) {
+            $(writeln!(out, "{}: {}", $name, $ident.load(Relaxed)).unwrap();)+
+            if let Some(snapshot) = &*EXT4_SNAPSHOT.lock() {
+                let (cached, evicted) = snapshot();
+                writeln!(out, "Ext4CachedBytes: {cached}\nExt4FlushEvictedBytes: {evicted}").unwrap();
+            }
+        }
+    };
+}
+
+counters! {
+    INODE => "SstInode", READ_CALLS => "SstReadCalls", READ_PAGES => "SstReadPages",
+    HITS => "SstResidentHits", FILLS => "SstRefillCalls", PAGES => "SstRefillPages",
+    EVICTIONS => "SstEvictions", RESIDENT => "SstResidentPages", PEAK => "SstPeakPages",
+    FILL_NS => "SstRefillNanos", COLLISIONS => "SstFillCollisions",
+    EXT4_READS => "Ext4ReadCalls", EXT4_BYTES => "Ext4ReadBytes",
+    EXT4_SMALL => "Ext4SmallCalls", EXT4_SMALL_BYTES => "Ext4SmallBytes",
+    SST_READS => "SstFillExt4Calls", SST_BYTES => "SstFillExt4Bytes",
+    SST_DISK_NS => "SstFillExt4Nanos",
+}
+
+pub(crate) static EXT4_SNAPSHOT: SpinNoPreempt<Option<Box<dyn Fn() -> (usize, usize) + Send + Sync>>> = SpinNoPreempt::new(None);
+static READER: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn read(pages: usize, hits: usize) {
+    READ_CALLS.fetch_add(1, Relaxed);
+    READ_PAGES.fetch_add(pages as u64, Relaxed);
+    HITS.fetch_add(hits as u64, Relaxed);
+}
+
+pub(crate) fn resident(pages: usize) {
+    RESIDENT.store(pages as u64, Relaxed);
+    PEAK.fetch_max(pages as u64, Relaxed);
+}
+
+pub(crate) struct Fill {
+    start: u64,
+    acquired: bool,
+}
+
+impl Fill {
+    pub(crate) fn new(pages: usize) -> Self {
+        FILLS.fetch_add(1, Relaxed);
+        PAGES.fetch_add(pages as u64, Relaxed);
+        let id = task::current().id().as_u64();
+        let acquired = READER.compare_exchange(0, id, Relaxed, Relaxed).is_ok();
+        if !acquired {
+            COLLISIONS.fetch_add(1, Relaxed);
+        }
+        Self { start: hal::time::monotonic_time_nanos(), acquired }
+    }
+}
+
+impl Drop for Fill {
+    fn drop(&mut self) {
+        if self.acquired {
+            READER.store(0, Relaxed);
+        }
+        FILL_NS.fetch_add(hal::time::monotonic_time_nanos() - self.start, Relaxed);
+    }
+}
+
+pub(crate) fn device_read(bytes: usize) -> Option<u64> {
+    EXT4_READS.fetch_add(1, Relaxed);
+    EXT4_BYTES.fetch_add(bytes as u64, Relaxed);
+    if bytes <= 4096 {
+        EXT4_SMALL.fetch_add(1, Relaxed);
+        EXT4_SMALL_BYTES.fetch_add(bytes as u64, Relaxed);
+    }
+    let id = READER.load(Relaxed);
+    if id != 0 && task::current().id().as_u64() == id {
+        SST_READS.fetch_add(1, Relaxed);
+        SST_BYTES.fetch_add(bytes as u64, Relaxed);
+        Some(hal::time::monotonic_time_nanos())
+    } else { None }
+}
