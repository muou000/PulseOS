  "retention": "Per-endpoint JSON, stderr and guest serial streams were saved locally during this run. The individual measurements below were extracted from those files. The raw files have no public archive or retention guarantee.",
  "udp_counts": "receiver_packets is the iperf3 receiver sequence count including inferred losses; observed datagrams = receiver_packets - reported_lost. Compare with sender_packets separately. A final datagram can be absent from the receiver count even with no reported sequence gap.",
  "tcp_telemetry": "For normal TCP the PulseOS sender reports zero cwnd, RTT and retransmits from the stub TCP_INFO. In VirtIO reverse the Linux host is the sender. Range covers the sending streams across successful attempts.",
  "run_columns": [
    "repeat",
    "sender_seconds",
    "receiver_seconds",
    "sender_Mbit_s",
    "receiver_Mbit_s",
    "sender_bytes",
    "receiver_bytes",
    "sender_packets",
    "receiver_packets",
    "reported_lost"
  ]
}
