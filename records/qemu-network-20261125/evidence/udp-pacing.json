{
  "method": {
    "environment": "../environment.json",
    "guest_vcpus": 8,
    "guest_memory_gib": 8,
    "network": "QEMU virt, snapshot=on, user networking; RISC-V MMIO with -cpu max, LoongArch PCI",
    "tool": "iperf3 3.22.1 at both endpoints",
    "ipv4": true,
    "streams_default": 1,
    "duration_seconds": 2,
    "interval_seconds": 1,
    "client_connect_timeout_ms": 3000,
    "guest_watchdog_seconds": 18,
    "command": "iperf3 -4 -c PEER -p PORT -t 2 -i 1 -J --connect-timeout 3000 [case options]",
    "server": "iperf3 -s -1 -B 127.0.0.1 -p PORT -J",
    "peer": "Loopback uses 127.0.0.1 inside the guest. VirtIO uses 10.0.2.2 with the host listener on 127.0.0.1. Both parties use the same port.",
    "unit": "Decimal Mbit/s, receiver end.sum_received.bits_per_second / 1e6; each reported run includes startup and shutdown. Reverse (-R) changes the sender.",
    "schedule": "One boot per architecture for this matrix. Interleave scenarios once per repetition. Architectures run serially on a shared 12-logical-CPU host.",
    "purpose": "Small-datagram pacing controls; fresh VM, one stream, 512 B, target 40 Mbit/s = 9765.625 payload datagrams/s."
  },
