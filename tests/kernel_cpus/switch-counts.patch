+++ b/modules/task/src/reservation_counts.rs
@@ -0,0 +1,83 @@
+//! First-user-switch-to-poweroff observations for the kernel CPU reservation guest test.
+
+use kspin::SpinNoIrq;
+
+const MAX_CPUS: usize = config::plat::MAX_CPU_NUM;
+
+#[derive(Clone, Copy)]
+struct Counts {
+    user_switches: u64,
+    last_user_task: u64,
+    user_preemptions: u64,
+    gc_task: u64,
+    gc_iterations: u64,
+}
+
+#[derive(Clone, Copy)]
+struct Observation {
+    cpus: [Counts; MAX_CPUS],
+    first_user: Option<(usize, u64, u64, u64)>,
+}
+
+static OBSERVATION: SpinNoIrq<Observation> = SpinNoIrq::new(Observation {
+    cpus: [Counts {
+        user_switches: 0,
+        last_user_task: 0,
+        user_preemptions: 0,
+        gc_task: 0,
+        gc_iterations: 0,
+    }; MAX_CPUS],
+    first_user: None,
+});
+
+/// Called only by the incoming user thread's task-extension switch hook.
+pub fn user_switch(tid: u64, task: u64) {
+    let mut observation = OBSERVATION.lock();
+    let cpu = hal::percpu::this_cpu_id();
+    observation.cpus[cpu].user_switches += 1;
+    observation.cpus[cpu].last_user_task = task;
+    observation
+        .first_user
+        .get_or_insert_with(|| (cpu, tid, task, hal::time::monotonic_time_nanos()));
+}
+
+/// Count only an involuntary switch to a different task from the last user
+/// task dispatched on this CPU. Scheduler task IDs are unique across its life.
+pub(crate) fn preempted(task: u64) {
+    let mut observation = OBSERVATION.lock();
+    let counts = &mut observation.cpus[hal::percpu::this_cpu_id()];
+    if counts.last_user_task == task {
+        counts.user_preemptions += 1;
+    }
+}
+
+/// Called from inside each pinned non-idle GC task, including after wakeups.
+pub(crate) fn gc_iteration(task: u64) {
+    let mut observation = OBSERVATION.lock();
+    if observation.first_user.is_none() {
+        return;
+    }
+    let counts = &mut observation.cpus[hal::percpu::this_cpu_id()];
+    counts.gc_task = task;
+    counts.gc_iterations += 1;
+}
+
+pub fn report() {
+    let (snapshot, end_ns) = {
+        let observation = OBSERVATION.lock();
+        (*observation, hal::time::monotonic_time_nanos())
+    };
+    let (cpu, tid, task, start_ns) = snapshot.first_user.expect("no user thread switched in");
+    info!(
+        "RESERVED_CPU_COUNTS first_cpu={cpu} first_tid={tid} first_task={task} end_ns={end_ns} \
+         start_ns={start_ns}"
+    );
+    for (cpu, counts) in snapshot.cpus.iter().enumerate().take(hal::cpu_num()) {
+        info!(
+            "RESERVED_CPU_COUNT cpu={cpu} user_switches={} gc_task={} gc_iterations={} \
+             user_preemptions={}",
+            counts.user_switches, counts.gc_task, counts.gc_iterations, counts.user_preemptions,
+        );
+    }
+    info!("RESERVED_CPU_COUNTS_END");
+}
