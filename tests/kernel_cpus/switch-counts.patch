diff --git a/modules/axtask/src/reservation_counts.rs b/modules/axtask/src/reservation_counts.rs
new file mode 100644
index 00000000..db1c0df1
--- /dev/null
+++ b/modules/axtask/src/reservation_counts.rs
@@ -0,0 +1,59 @@
+//! Boot-to-poweroff observations for the kernel CPU reservation guest test.
+
+use kspin::SpinNoIrq;
+
+const MAX_CPUS: usize = axconfig::plat::MAX_CPU_NUM;
+
+#[derive(Clone, Copy)]
+struct Counts {
+    user_switches: u64,
+    gc_task: u64,
+    gc_iterations: u64,
+}
+
+#[derive(Clone, Copy)]
+struct Observation {
+    cpus: [Counts; MAX_CPUS],
+    first_user: Option<(usize, u64, u64)>,
+}
+
+static OBSERVATION: SpinNoIrq<Observation> = SpinNoIrq::new(Observation {
+    cpus: [Counts {
+        user_switches: 0,
+        gc_task: 0,
+        gc_iterations: 0,
+    }; MAX_CPUS],
+    first_user: None,
+});
+
+/// Called only by the incoming user thread's task-extension switch hook.
+pub fn user_switch(tid: u64, task: u64) {
+    let mut observation = OBSERVATION.lock();
+    let cpu = axhal::percpu::this_cpu_id();
+    observation.cpus[cpu].user_switches += 1;
+    observation.first_user.get_or_insert((cpu, tid, task));
+}
+
+/// Called from inside each pinned non-idle GC task, including after wakeups.
+pub(crate) fn gc_iteration(task: u64) {
+    let mut observation = OBSERVATION.lock();
+    let counts = &mut observation.cpus[axhal::percpu::this_cpu_id()];
+    counts.gc_task = task;
+    counts.gc_iterations += 1;
+}
+
+pub fn report() {
+    let (snapshot, end_ns) = {
+        let observation = OBSERVATION.lock();
+        (*observation, axhal::time::monotonic_time_nanos())
+    };
+    let (cpu, tid, task) = snapshot.first_user.expect("no user thread switched in");
+    info!("RESERVED_CPU_COUNTS first_cpu={cpu} first_tid={tid} first_task={task} end_ns={end_ns}");
+    for (cpu, counts) in snapshot.cpus.iter().enumerate().take(axhal::cpu_num()) {
+        info!(
+            "RESERVED_CPU_COUNT cpu={cpu} user_switches={} gc_task={} gc_iterations={}",
+            counts.user_switches, counts.gc_task, counts.gc_iterations,
+        );
+    }
+    info!("RESERVED_CPU_COUNTS_END");
+}
